# Copy this file to .env (it is gitignored and never committed) and fill it in.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

DATABASE_URL="file:./prisma/dev.db"

# Signs staff login sessions. Generate your own random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the same secret across environments, and never commit it.
SESSION_SECRET="replace-this-with-your-own-random-secret"

# Password needed once, on the /setup page, the very first time this
# installation runs (each clinic runs its own separate copy of this app on
# its own computer - there is no shared central server). After setup is
# done, this password is never asked again.
SETUP_PASSWORD="replace-this-with-your-own-password"

# Encrypts messenger bot tokens (Telegram/Bale) before they're stored.
# Generate your own random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="replace-this-with-your-own-random-key"

# Anthropic API key that powers the AI receptionist bot (Telegram/Bale).
# Get one at https://console.anthropic.com/ - you pay Anthropic directly for
# what the bot uses; this is not free. Leave empty until you're ready for the
# bot phase; the rest of the panel works fine without it.
ANTHROPIC_API_KEY=""

# Which Claude model the bot uses to chat with patients. Default is the
# cheapest current model (Haiku 4.5), which is plenty for a receptionist bot
# (scheduling + short chat, no heavy reasoning). You can change this to
# "claude-sonnet-5" or "claude-opus-5" for smarter (but pricier) replies.
ASSISTANT_MODEL="claude-haiku-4-5"
