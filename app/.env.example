# Copy this file to .env (it is gitignored and never committed) and fill it in.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

DATABASE_URL="file:./prisma/dev.db"

# Signs staff login sessions. Generate your own random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the same secret across environments, and never commit it.
SESSION_SECRET="replace-this-with-your-own-random-secret"

# Password needed once, on the /setup page, the very first time this
# installation runs (each clinic runs its own separate copy of this app on
# its own computer - there is no shared central server). After setup is
# done, this password is never asked again.
SETUP_PASSWORD="replace-this-with-your-own-password"

# Encrypts messenger bot tokens (Telegram/Bale) before they're stored.
# Generate your own random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="replace-this-with-your-own-random-key"

# API key that powers the AI receptionist bot (Telegram/Bale). Not tied to
# one AI company - works with any OpenAI-compatible provider. Default setup
# is OpenRouter (https://openrouter.ai - one key, access to many models,
# including free/cheap options). Leave empty until you're ready for the bot
# phase; the rest of the panel works fine without it.
AI_API_KEY=""

# Which API the bot talks to. Default is OpenRouter. Point this at
# "https://api.openai.com/v1" to use OpenAI directly, or any other
# OpenAI-compatible endpoint (self-hosted models, other providers, etc).
AI_BASE_URL="https://openrouter.ai/api/v1"

# Which model the bot uses to chat with patients, in "provider/model" form
# (OpenRouter's naming). Check https://openrouter.ai/models for the current
# list, including free ones (they end in ":free"). The rest of the panel
# doesn't care which model you pick - this is scheduling + short chat, no
# heavy reasoning needed.
AI_MODEL="openai/gpt-4o-mini"
