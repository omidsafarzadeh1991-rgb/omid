# Copy this file to .env (it is gitignored and never committed) and fill it in.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

DATABASE_URL="file:./prisma/dev.db"

# Signs staff login sessions. Generate your own random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the same secret across environments, and never commit it.
SESSION_SECRET="replace-this-with-your-own-random-secret"

# Password to log in at /superadmin/login and create new clinics.
# Only you (the system owner) should know this.
SUPERADMIN_PASSWORD="replace-this-with-your-own-password"
