// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// OWNER: exactly one per install, created only during /setup, sees secrets
// (bot tokens, webhook secret, SMS API key), security log, backups.
// ADMIN: manages doctors/staff/catalog/AI instructions, can enable/disable
// bots and reminders, but never sees a decrypted secret.
// RECEPTIONIST: booking only, no access to settings.
enum StaffRole {
  OWNER
  ADMIN
  RECEPTIONIST
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  BOT_TOKEN_UPDATED
  SMS_SETTINGS_UPDATED
  BACKUP_CREATED
  OWNER_PASSWORD_RECOVERED
}

enum SmsReminderType {
  CONFIRMATION
  REMINDER_24H
  REMINDER_2_4H
}

enum FaqCategory {
  ADDRESS
  WORKING_HOURS
  INSURANCE
  PAYMENT
  BOOKING
  DOCTORS
  SERVICES
  CLINIC_RULES
  OTHER
}

enum AppointmentSource {
  MANUAL
  TELEGRAM
  BALE
  WHATSAPP
  INSTAGRAM
}

enum AppointmentAction {
  BOOKED
  CANCELLED
}

enum BotPlatform {
  TELEGRAM
  BALE
}

enum MessageResolution {
  FAQ
  AI
  AI_ERROR
}

enum ConversationStatus {
  NEW
  IN_REVIEW
  WAITING_PATIENT
  WAITING_CLINIC
  BOOKED
  INCOMPLETE
  CLOSED
}

enum ConversationNoteType {
  NOTE
  CALL_OUTCOME
  STATUS_CHANGE
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Free-text instructions the clinic admin writes for the AI receptionist
  // bot (what to say / what not to say, extra info like address). Always
  // layered on top of the app's fixed safety rules in lib/assistant.ts,
  // which the admin's text can never override (e.g. no medical advice).
  assistantInstructions String?

  staff       StaffUser[]
  doctors     Doctor[]
  appointments Appointment[]
  botIntegrations BotIntegration[]
  botConversations BotConversation[]
  conversationNotes ConversationNote[]
  services    Service[]
  specialties Specialty[]
  smsSettings SmsSettings?
  securityLogs SecurityLog[]
  faqEntries  FaqEntry[]
  clinicInfo  ClinicInfo?
  waitlistEntries Waitlist[]
  messageLogs MessageLog[]
}

// Append-only security/audit trail, visible only to OWNER.
model SecurityLog {
  id           String            @id @default(cuid())
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  event        SecurityEventType
  detail       String?
  actorStaffId String?
  actorStaff   StaffUser?        @relation(fields: [actorStaffId], references: [id])
  createdAt    DateTime          @default(now())

  @@index([clinicId, createdAt])
}

// One row per clinic (there is only ever one clinic per install). The SMS
// API key is encrypted the same way bot tokens are; only OWNER can set it.
// ADMIN can toggle which reminder types are on and edit their text.
model SmsSettings {
  id                    String   @id @default(cuid())
  clinicId              String   @unique
  clinic                Clinic   @relation(fields: [clinicId], references: [id])
  provider              String   @default("KAVENEGAR")
  encryptedApiKey       String?
  senderNumber          String?
  confirmationEnabled   Boolean  @default(true)
  reminder24hEnabled    Boolean  @default(true)
  reminder2to4hEnabled  Boolean  @default(true)
  confirmationTemplate  String?
  reminder24hTemplate   String?
  reminder2to4hTemplate String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

// Append-only send-attempt log per appointment, so a reminder is never sent
// twice even if the periodic sweep (lib/reminders.ts) overlaps or restarts.
model AppointmentReminder {
  id            String          @id @default(cuid())
  appointmentId String
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          SmsReminderType
  sentAt        DateTime        @default(now())
  success       Boolean
  errorMessage  String?

  @@unique([appointmentId, type])
}

// Cheap, deterministic answers checked before ever calling the paid AI
// model (see lib/knowledge.ts) - keyword-matched, no AI involved.
model FaqEntry {
  id        String      @id @default(cuid())
  clinicId  String
  clinic    Clinic      @relation(fields: [clinicId], references: [id])
  category  FaqCategory @default(OTHER)
  question  String
  answer    String
  // Comma-separated match terms, checked as substrings of the normalized
  // incoming message - no separate synonym-management UI needed.
  keywords  String
  priority  Int         @default(50)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([clinicId, active])
}

// One row per clinic (there is only ever one clinic per install). Fed into
// the AI's system prompt so it never has to invent an address, phone
// number, or insurance answer - and also answers simple keyword questions
// (e.g. "پارکینگ دارید؟") without calling the AI at all.
model ClinicInfo {
  id                 String   @id @default(cuid())
  clinicId           String   @unique
  clinic             Clinic   @relation(fields: [clinicId], references: [id])
  address            String?
  phone              String?
  whatsapp           String?
  contactEmail       String?
  website            String?
  instagram          String?
  googleMapUrl       String?
  workingHoursNote   String?
  parkingAvailable   Boolean  @default(false)
  parkingDescription String?
  insuranceNote      String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

// Per-clinic messenger bot connection. The token is encrypted at rest
// (see lib/crypto.ts) and is never sent back to the browser after saving.
model BotIntegration {
  id                    String      @id @default(cuid())
  clinicId              String
  clinic                Clinic      @relation(fields: [clinicId], references: [id])
  platform              BotPlatform
  encryptedToken        String
  // Shared secret Telegram/Bale echoes back on every webhook call (verified
  // against the platform's signature header) so forged requests are rejected.
  // Nullable so upgrading an existing row doesn't require a backfill migration;
  // lib/settings.ts generates and saves one lazily on first use.
  encryptedWebhookSecret String?
  enabled                Boolean     @default(false)
  updatedAt              DateTime    @updatedAt
  createdAt              DateTime    @default(now())

  @@unique([clinicId, platform])
}

// Per-chat conversation history with the AI receptionist, so multi-turn
// context survives across separate webhook requests (each incoming message
// is its own HTTP call). history is a JSON-serialized array of Anthropic
// message params. Also doubles as the patient-follow-up record shown in
// the staff "مکالمات" panel, so no inbound message from any channel is
// ever silently lost.
model BotConversation {
  id             String      @id @default(cuid())
  clinicId       String
  clinic         Clinic      @relation(fields: [clinicId], references: [id])
  platform       BotPlatform
  externalChatId String
  history        String      @default("[]")

  patientName     String?
  patientPhone    String?
  status          ConversationStatus @default(NEW)
  assignedStaffId String?
  assignedStaff   StaffUser?         @relation(fields: [assignedStaffId], references: [id])
  // Timestamp/text of the most recent message in either direction (patient
  // or bot). Deliberately separate from updatedAt, which also changes when
  // staff edit status/notes - the follow-up/incomplete timers must only
  // move on real conversation activity.
  lastMessageAt   DateTime           @default(now())
  lastMessageText String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  notes ConversationNote[]

  @@unique([clinicId, platform, externalChatId])
  @@index([clinicId, status])
}

// Append-only log of staff follow-up actions on a conversation (manual
// notes, call outcomes, status changes) - never edited or deleted, so the
// full follow-up history survives even after the conversation is closed.
model ConversationNote {
  id             String               @id @default(cuid())
  clinicId       String
  clinic         Clinic               @relation(fields: [clinicId], references: [id])
  conversationId String
  conversation   BotConversation      @relation(fields: [conversationId], references: [id])
  type           ConversationNoteType
  text           String
  authorStaffId  String?
  authorStaff    StaffUser?           @relation(fields: [authorStaffId], references: [id])
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

model StaffUser {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  // Login identifier now - not the email, which is optional contact info.
  username     String    @unique
  firstName    String
  lastName     String?
  email        String?   @unique
  mobile       String?
  birthDate    DateTime?
  // Separate from username: an internal payroll/reference code, not used to log in.
  personnelCode String?  @unique
  hireDate     DateTime?
  notes        String?
  profilePictureUrl String?
  passwordHash String
  role         StaffRole @default(RECEPTIONIST)
  active       Boolean   @default(true)
  // Forces a password-change screen right after next successful login.
  mustChangePassword Boolean @default(false)
  // Persisted history of wrong-password attempts, separate from the
  // in-memory time-windowed rate limiter in lib/rate-limit.ts - reset to 0
  // on a successful login.
  failedLoginCount Int @default(0)
  createdAt    DateTime  @default(now())

  assignedConversations BotConversation[]
  conversationNotes     ConversationNote[]
  securityLogs          SecurityLog[]
}

model Doctor {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  slotMinutes Int      @default(30)
  createdAt   DateTime @default(now())

  appointments Appointment[]
  services     Service[]
  specialties  Specialty[]
  schedules    DoctorSchedule[]
  waitlistEntries Waitlist[]
}

// Clinic-wide catalog of specialties (e.g. "دندانپزشکی عمومی", "ارتودنسی").
// Admin defines these once, then picks which apply to each doctor.
model Specialty {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  createdAt DateTime @default(now())

  doctors Doctor[]

  @@unique([clinicId, name])
}

// One row per day of week the doctor is present, so hours can differ by
// day (e.g. Saturday 10:00-18:00, Wednesday 12:00-15:00). No row for a
// given day means the doctor doesn't work that day.
model DoctorSchedule {
  id        String @id @default(cuid())
  doctorId  String
  doctor    Doctor @relation(fields: [doctorId], references: [id])
  dayOfWeek Int // JS Date#getDay(): 0=Sunday ... 6=Saturday
  startMin  Int // minutes from midnight
  endMin    Int // minutes from midnight

  @@unique([doctorId, dayOfWeek])
}

// Clinic-wide catalog of services (e.g. "ویزیت عمومی - 200000"). Admin
// defines these once, then picks which doctors offer each one.
model Service {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  price     Int? // تومان؛ خالی یعنی قیمت مشخص نشده
  // غیرفعال یعنی دیگر برای پزشک جدید قابل انتخاب نیست، اما چون
  // Appointment.serviceName فقط یک متن ذخیره‌شده است (نه لینک به این
  // ردیف)، غیرفعال یا حتی حذف این رکورد هیچ نوبت قبلی را دستکاری نمی‌کند.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  doctors Doctor[]

  @@unique([clinicId, name])
}

model Appointment {
  id           String            @id @default(cuid())
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  startTime    DateTime
  patientName  String
  patientPhone String
  serviceName  String?
  source       AppointmentSource @default(MANUAL)
  // Shared id across every occurrence created together by the "weekly
  // repeat" option (see lib/booking.ts createRecurringAppointments). Null
  // for a normal one-off booking. Purely a grouping tag - each occurrence
  // still goes through the same atomic bookAppointment() call and is bound
  // by the same (doctorId, startTime) unique constraint, so recurring
  // bookings never bypass the double-booking guard.
  recurringGroupId String?
  createdAt    DateTime          @default(now())

  // A row here means the slot is actively booked. The DB-level unique
  // constraint is the actual double-booking guard: two concurrent booking
  // attempts for the same doctor+time race to insert, and only one wins.
  // Cancelling an appointment deletes this row (see lib/booking.ts) and
  // is recorded in AppointmentLog for history.
  reminders AppointmentReminder[]

  @@unique([doctorId, startTime])
  @@index([clinicId, startTime])
  @@index([clinicId, recurringGroupId])
}

// Append-only audit trail. Rows are never deleted or edited, so clinics
// always have a full history even after an appointment row is cancelled.
model AppointmentLog {
  id            String            @id @default(cuid())
  clinicId      String
  doctorId      String
  startTime     DateTime
  patientName   String
  patientPhone  String
  source        AppointmentSource
  action        AppointmentAction
  actorStaffId  String?
  createdAt     DateTime          @default(now())

  // Covers the dashboard's per-clinic booked-count/channel-share queries
  // (filtered by clinicId+action, sometimes +createdAt) so they stay fast
  // as this append-only table grows into the hundreds of thousands of rows
  // over years of daily use, instead of scanning every row for the clinic.
  @@index([clinicId, startTime])
  @@index([clinicId, action, createdAt])
}

// One row per incoming bot message, recording which layer answered it and
// (for AI answers) how many tokens it cost - purely for the "how much of
// this could become a free FAQ instead" report at app/dashboard/ai-usage.
// Never read by the assistant itself, so a failure to write here must never
// block a reply (see lib/message-log.ts).
model MessageLog {
  id               String            @id @default(cuid())
  clinicId         String
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  platform         BotPlatform
  resolution       MessageResolution
  responseMs       Int
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime          @default(now())

  @@index([clinicId, createdAt])
  @@index([clinicId, resolution, createdAt])
}

// A patient waiting for a day that has no free slot right now. Purely a
// staff-visible list (no automatic SMS - that costs money per message, see
// CLAUDE.md); when a slot opens up staff notice it here and book manually.
// Deleting the row (converted to a real booking, or the patient no longer
// wants it) is the only lifecycle - no separate status field needed.
model Waitlist {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id])
  day          DateTime
  patientName  String
  patientPhone String
  serviceName  String?
  createdAt    DateTime @default(now())

  @@index([clinicId, doctorId, day])
}
