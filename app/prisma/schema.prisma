// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StaffRole {
  ADMIN
  RECEPTIONIST
}

enum AppointmentSource {
  MANUAL
  TELEGRAM
  BALE
  WHATSAPP
  INSTAGRAM
}

enum AppointmentAction {
  BOOKED
  CANCELLED
}

enum BotPlatform {
  TELEGRAM
  BALE
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Free-text instructions the clinic admin writes for the AI receptionist
  // bot (what to say / what not to say, extra info like address). Always
  // layered on top of the app's fixed safety rules in lib/assistant.ts,
  // which the admin's text can never override (e.g. no medical advice).
  assistantInstructions String?

  staff       StaffUser[]
  doctors     Doctor[]
  appointments Appointment[]
  botIntegrations BotIntegration[]
  botConversations BotConversation[]
}

// Per-clinic messenger bot connection. The token is encrypted at rest
// (see lib/crypto.ts) and is never sent back to the browser after saving.
model BotIntegration {
  id                    String      @id @default(cuid())
  clinicId              String
  clinic                Clinic      @relation(fields: [clinicId], references: [id])
  platform              BotPlatform
  encryptedToken        String
  // Shared secret Telegram/Bale echoes back on every webhook call (verified
  // against the platform's signature header) so forged requests are rejected.
  // Nullable so upgrading an existing row doesn't require a backfill migration;
  // lib/settings.ts generates and saves one lazily on first use.
  encryptedWebhookSecret String?
  enabled                Boolean     @default(false)
  updatedAt              DateTime    @updatedAt
  createdAt              DateTime    @default(now())

  @@unique([clinicId, platform])
}

// Per-chat conversation history with the AI receptionist, so multi-turn
// context survives across separate webhook requests (each incoming message
// is its own HTTP call). history is a JSON-serialized array of Anthropic
// message params.
model BotConversation {
  id             String      @id @default(cuid())
  clinicId       String
  clinic         Clinic      @relation(fields: [clinicId], references: [id])
  platform       BotPlatform
  externalChatId String
  history        String      @default("[]")
  updatedAt      DateTime    @updatedAt
  createdAt      DateTime    @default(now())

  @@unique([clinicId, platform, externalChatId])
}

model StaffUser {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(RECEPTIONIST)
  createdAt    DateTime  @default(now())
}

model Doctor {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  slotMinutes Int      @default(30)
  createdAt   DateTime @default(now())

  appointments Appointment[]
  services     Service[]
  schedules    DoctorSchedule[]
}

// One row per day of week the doctor is present, so hours can differ by
// day (e.g. Saturday 10:00-18:00, Wednesday 12:00-15:00). No row for a
// given day means the doctor doesn't work that day.
model DoctorSchedule {
  id        String @id @default(cuid())
  doctorId  String
  doctor    Doctor @relation(fields: [doctorId], references: [id])
  dayOfWeek Int // JS Date#getDay(): 0=Sunday ... 6=Saturday
  startMin  Int // minutes from midnight
  endMin    Int // minutes from midnight

  @@unique([doctorId, dayOfWeek])
}

model Service {
  id        String   @id @default(cuid())
  clinicId  String
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  name      String
  price     Int? // تومان؛ خالی یعنی قیمت مشخص نشده
  createdAt DateTime @default(now())

  @@index([doctorId])
}

model Appointment {
  id           String            @id @default(cuid())
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  startTime    DateTime
  patientName  String
  patientPhone String
  serviceName  String?
  source       AppointmentSource @default(MANUAL)
  createdAt    DateTime          @default(now())

  // A row here means the slot is actively booked. The DB-level unique
  // constraint is the actual double-booking guard: two concurrent booking
  // attempts for the same doctor+time race to insert, and only one wins.
  // Cancelling an appointment deletes this row (see lib/booking.ts) and
  // is recorded in AppointmentLog for history.
  @@unique([doctorId, startTime])
  @@index([clinicId, startTime])
}

// Append-only audit trail. Rows are never deleted or edited, so clinics
// always have a full history even after an appointment row is cancelled.
model AppointmentLog {
  id            String            @id @default(cuid())
  clinicId      String
  doctorId      String
  startTime     DateTime
  patientName   String
  patientPhone  String
  source        AppointmentSource
  action        AppointmentAction
  actorStaffId  String?
  createdAt     DateTime          @default(now())

  @@index([clinicId, startTime])
}
