# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# Your personal Telegram numeric chat id (the clinic admin who approves/rejects bookings)
ADMIN_CHAT_ID=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Sheets ---
# The spreadsheet id from the sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=

# Paste the ENTIRE contents of the service account JSON key file as a single line here
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Clinic settings ---
CLINIC_NAME=مطب دکتر
CLINIC_TIMEZONE=Asia/Tehran
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
SLOT_MINUTES=30
# Comma separated, 0=Sunday ... 6=Saturday (Iran work week example: Sat-Wed)
CLINIC_WORK_DAYS=0,1,2,3,6
